<?xml version="1.0" encoding="utf-8" ?>
<component name="FetchVideosTask" extends="Task">
    <interface>
        <!-- "em-alta" ou "recentes" -->
        <field id="feed" type="string" value="em-alta" />
        <field id="page" type="integer" value="1" />
        <!-- resultado: roArray de roAssociativeArray (vindos do /api/videos) -->
        <field id="result" type="assocarray" alwaysNotify="true" />
        <field id="errorMessage" type="string" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/source/Config.brs" />
    <script type="text/brightscript" uri="pkg:/source/Net.brs" />
    <script type="text/brightscript" uri="pkg:/components/FetchVideosTask.brs" />
</component>
