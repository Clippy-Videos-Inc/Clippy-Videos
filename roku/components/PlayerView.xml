<?xml version="1.0" encoding="utf-8" ?>
<component name="PlayerView" extends="Group">
    <interface>
        <field id="videoId" type="string" onChange="OnVideoIdChange" />
        <!-- MainScene observa estes campos -->
        <field id="closeRequested" type="boolean" alwaysNotify="true" value="false" />
        <field id="selectedChannel" type="string" alwaysNotify="true" />
        <function name="Reset" />
    </interface>

    <children>
        <Rectangle id="bg" width="1920" height="1080" color="0x000000FF" />

        <Video
            id="video"
            width="1920"
            height="1080"
            visible="false"
        />

        <BusySpinner
            id="spinner"
            translation="[928, 460]"
            visible="false"
        />

        <Label
            id="errorLabel"
            translation="[160, 460]"
            width="1600"
            wrap="true"
            horizAlign="center"
            font="font:MediumSystemFont"
            color="0xFF6B6BFF"
            visible="false"
        />

        <Rectangle
            id="titleBar"
            translation="[0, 0]"
            width="1920"
            height="170"
            color="0x000000AA"
            visible="false"
        />
        <Label
            id="titleOverlay"
            translation="[64, 56]"
            width="1600"
            font="font:LargeSystemFont"
            color="0xFFFFFFFF"
            visible="false"
        />
        <Label
            id="badge360"
            text="360°"
            translation="[1780, 60]"
            font="font:MediumBoldSystemFont"
            color="0x7C3AEDFF"
            visible="false"
        />
        <Button
            id="channelButton"
            translation="[64, 108]"
            minWidth="400"
            visible="false"
        />

        <Label
            id="toastLabel"
            translation="[64, 980]"
            font="font:MediumBoldSystemFont"
            color="0xFFFFFFFF"
            visible="false"
        />
        <Label
            id="hintLabel"
            text="BAIXO: ver canal   •   OPÇÕES: trocar qualidade"
            translation="[64, 1030]"
            font="font:SmallSystemFont"
            color="0x9A9AA5FF"
            visible="false"
        />
    </children>

    <script type="text/brightscript" uri="pkg:/components/PlayerView.brs" />
</component>
