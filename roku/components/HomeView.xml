<?xml version="1.0" encoding="utf-8" ?>
<component name="HomeView" extends="Group">
    <interface>
        <!-- id do vídeo escolhido pelo usuário; observado pela MainScene -->
        <field id="selectedVideoId" type="string" alwaysNotify="true" />
        <!-- username escolhido via botão OPTIONS num card; observado pela MainScene -->
        <field id="selectedChannel" type="string" alwaysNotify="true" />
        <function name="FocusGrid" />
    </interface>

    <children>
        <BusySpinner
            id="spinner"
            translation="[928, 460]"
            visible="false"
        />

        <Label
            id="errorLabel"
            translation="[64, 300]"
            width="1792"
            wrap="true"
            font="font:MediumSystemFont"
            color="0xFF6B6BFF"
            visible="false"
        />

        <RowList
            id="rowList"
            translation="[0, 150]"
            itemComponentName="VideoItem"
            rowItemSize="[[360, 230]]"
            rowItemSpacing="[[24, 0]]"
            rowHeights="[280, 280]"
            rowSpacings="[0, 48]"
            rowLabelOffset="[[64, 10]]"
            showRowLabel="[true, true]"
            numRows="2"
            focusXOffset="[64, 64]"
            vertFocusAnimationStyle="floatingFocus"
            visible="false"
        />
    </children>

    <script type="text/brightscript" uri="pkg:/source/Utils.brs" />
    <script type="text/brightscript" uri="pkg:/components/HomeView.brs" />
</component>
